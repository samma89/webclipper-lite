{
  "manifest_version": 3,
  "name": "Clipper Lite",
  "version": "1.0.0",
  "description": "Pick the content on a page, then save it to a local library. Export as Markdown, HTML or JSON.",
  "minimum_chrome_version": "102",
  "homepage_url": "https://github.com/samma89/webclipper-lite",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open the clipper on the current page"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "Clip this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
